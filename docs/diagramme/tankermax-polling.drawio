        </mxCell>
        <mxCell id="f_d1" value="Orte&#10;konfiguriert?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="90" y="130" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f_skip" value="überspringen&#10;(WARN protokollieren)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="300" y="145" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f_count" value="pending = Tankstellen&#10;ohne Detaildaten zählen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="250" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f_d2" value="pending == 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="90" y="340" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f_d3" value="Anreicherung&#10;blockiert?&#10;(maxStallCycles)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="335" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f_pause" value="Preisabfrage pausieren&#10;(Anreicherung hat Vorrang)&#10;→ nächstes Intervall warten" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="540" y="335" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f_reset" value="Anreicherungs-Tracking&#10;zurücksetzen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="460" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f_pick" value="nächsten Ort wählen&#10;(Rotation)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="550" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f_fetch" value="apiClient.fetchStations(location)&#10;[RateLimiter.awaitSlot]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="50" y="640" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f_loop" value="für jede Tankstelle&#10;(eigene Transaktion)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="730" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f_save" value="StationCatalogService.saveFromListItem()&#10;(Station + Marke anlegen/aktualisieren)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f_record" value="PriceRecordingService.recordFromListItem()&#10;→ PriceObservation + FuelPrice (E5/E10/Diesel)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f_end" value="Zusammenfassung&#10;protokollieren" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="990" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="fe1" value="" style="endArrow=open;html=1;" edge="1" parent="1" source="f_start" target="f_d1">
