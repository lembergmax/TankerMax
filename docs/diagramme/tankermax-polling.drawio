        <mxCell id="f_note" value="Anreicherung (StationDetailEnrichmentService) läuft als eigener Zeitplan:&#10;solange pending &gt; 0 ruft sie je Tankstelle detail.php ab (RateLimiter-gedrosselt)&#10;und übernimmt Öffnungszeiten, Ausnahmeregeln und Bundesland. Die&#10;Preisabfrage pausiert so lange (siehe Verzweigung oben)." style="text;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#999999;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="640" width="420" height="100" as="geometry" />
