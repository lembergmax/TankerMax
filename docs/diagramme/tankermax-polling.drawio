        <mxCell id="fe5" value="nein" style="endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="f_d2" target="f_d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe6" value="ja" style="endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="f_d2" target="f_reset">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe7" value="nein" style="endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="f_d3" target="f_pause">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe8" value="ja (erzwingen)" style="endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="f_d3" target="f_pick">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe9" value="" style="endArrow=open;html=1;" edge="1" parent="1" source="f_reset" target="f_pick">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe10" value="" style="endArrow=open;html=1;" edge="1" parent="1" source="f_pick" target="f_fetch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe11" value="" style="endArrow=open;html=1;" edge="1" parent="1" source="f_fetch" target="f_loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe12" value="" style="endArrow=open;html=1;" edge="1" parent="1" source="f_loop" target="f_save">
          <mxGeometry relative="1" as="geometry" />
