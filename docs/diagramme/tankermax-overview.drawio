<mxfile host="Electron">
  <diagram name="Gesamtablauf (generisch)" id="overview-gen">
    <mxGraphModel dx="1488" dy="1013" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="o_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;" value="TankerMax — Gesamtablauf (generisch): von der externen Preis-API über den Datenspeicher zur Oberfläche" vertex="1">
          <mxGeometry height="30" width="790" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="o_api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="Externe Preis-API&#xa;liefert Tankstellen und aktuelle Spritpreise&#xa;(Anfrage an einen Endpunkt mit Ort bzw. Kennung)" vertex="1">
          <mxGeometry height="72" width="420" x="120" y="70" as="geometry" />
        </mxCell>
        <mxCell id="o_ingest_grp" parent="1" style="swimlane;startSize=26;html=1;fillColor=none;strokeColor=#82b366;fontStyle=1;fontSize=12;verticalAlign=top;" value="Datensammlung — Hintergrunddienst (läuft ohne Oberfläche)" vertex="1">
          <mxGeometry height="248" width="520" x="70" y="200" as="geometry" />
        </mxCell>
        <mxCell id="o_poll" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Regelmäßig Preise abrufen&#xa;je Durchlauf eine Region, danach zur nächsten wechseln" vertex="1">
          <mxGeometry height="40" width="420" x="120" y="240" as="geometry" />
        </mxCell>
        <mxCell id="o_enrich" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Zusatzinfos nachladen (Öffnungszeiten, Region)&#xa;hat Vorrang vor der Preisabfrage, bis alle erfasst sind" vertex="1">
          <mxGeometry height="40" width="420" x="120" y="290" as="geometry" />
        </mxCell>
        <mxCell id="o_client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Anfragen an die API senden&#xa;zentral gedrosselt, damit das Ratenlimit eingehalten wird" vertex="1">
          <mxGeometry height="40" width="420" x="120" y="340" as="geometry" />
        </mxCell>
        <mxCell id="o_persist" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Antworten auswerten und speichern&#xa;Stammdaten, Preise und Zusatzinfos im Datenspeicher ablegen" vertex="1">
          <mxGeometry height="44" width="420" x="120" y="392" as="geometry" />
        </mxCell>
        <mxCell id="o_db" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="Zentraler Datenspeicher&#xa;Tankstellen · Marken · Kraftstoffarten&#xa;Preisbeobachtungen · Preise&#xa;Öffnungszeiten · Ausnahmeregeln" vertex="1">
          <mxGeometry height="120" width="200" x="230" y="510" as="geometry" />
        </mxCell>
        <mxCell id="o_web_grp" parent="1" style="swimlane;startSize=26;html=1;fillColor=none;strokeColor=#82b366;fontStyle=1;fontSize=12;verticalAlign=top;" value="Auswertung &amp; Anzeige — Web-Schnittstelle (nur lesend)" vertex="1">
          <mxGeometry height="170" width="520" x="70" y="700" as="geometry" />
        </mxCell>
        <mxCell id="o_query" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Daten lesen und aufbereiten&#xa;Region, aktueller Preis je Tankstelle, Preisverlauf" vertex="1">
          <mxGeometry height="44" width="420" x="120" y="740" as="geometry" />
        </mxCell>
        <mxCell id="o_ctrl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Über Endpunkte als Antwort bereitstellen&#xa;feste Reihenfolge: erst Grundinfos, dann Regionen, dann Tankstellen, dann Preisverlauf" vertex="1">
          <mxGeometry height="44" width="420" x="120" y="796" as="geometry" />
        </mxCell>
        <mxCell id="o_browser" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="Web-Oberfläche im Browser&#xa;zeigt Tankstellen, aktuelle Preise und den Preisverlauf&#xa;und fragt die Daten bei der Web-Schnittstelle an" vertex="1">
          <mxGeometry height="84" width="420" x="120" y="920" as="geometry" />
        </mxCell>
        <mxCell id="o_note" parent="1" style="text;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#999999;spacing=8;fontSize=11;" value="Zwei Rollen&#xa;• Sammeln: ruft regelmäßig die externe API ab und schreibt die Daten in den Speicher.&#xa;• Anzeigen: liest die Daten nur und stellt sie über Endpunkte bereit.&#xa;• Beide Rollen können getrennt oder gemeinsam laufen.&#xa;&#xa;Die Oberfläche fragt die externe API nie selbst an – sie zeigt nur, was zuvor gesammelt wurde." vertex="1">
          <mxGeometry height="120" width="490" x="610" y="510" as="geometry" />
        </mxCell>
        <mxCell id="oe1" edge="1" parent="1" source="o_api" style="endArrow=block;html=1;fontSize=11;strokeWidth=2;strokeColor=#d79b00;" target="o_ingest_grp" value="Daten abrufen (Anfrage → Antwort)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="oe2" edge="1" parent="1" source="o_ingest_grp" style="endArrow=block;html=1;fontSize=11;strokeWidth=2;strokeColor=#9673a6;" target="o_db" value="speichern (schreibend)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="oe3" edge="1" parent="1" source="o_db" style="endArrow=block;html=1;fontSize=11;strokeWidth=2;strokeColor=#9673a6;" target="o_web_grp" value="lesen (nur lesend)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="oe4" edge="1" parent="1" source="o_web_grp" style="endArrow=block;html=1;fontSize=11;strokeWidth=2;strokeColor=#6c8ebf;" target="o_browser" value="Daten als Antwort">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
