# Vorlage für die lokale .env-Datei. Kopieren nach `.env` und Werte eintragen.
# Die echte .env-Datei ist per .gitignore vom Versionskontrollsystem ausgeschlossen.

# Persönlicher Tankerkönig-API-Schlüssel (https://creativecommons.tankerkoenig.de).
TANKERKOENIG_API_KEY=dein-api-schlüssel

# Haupt-Datenbank. createDatabaseIfNotExist legt die Datenbank beim ersten Start an.
DB_URL=jdbc:mariadb://localhost:3306/tankermax?createDatabaseIfNotExist=true
DB_USERNAME=tankermax
DB_PASSWORD=tankermax
